<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Maven Selenium Practice Suite">
    <listeners>
        <!-- Your custom screenshot/logging listener -->
        <listener class-name="com.sachin.utilities.TestListener"/>
        
        <!-- ALLURE LISTENER (Required to capture test data for report) -->
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>

        <classes>
            <class name="com.sachin.tests.LoginTest"/>
        </classes>
    </test>
</suite>